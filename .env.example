# R2M runtime configuration. Copy to .env (never commit .env). Values marked SECRET must be generated per environment.

# --- Required ---------------------------------------------------------------
APP_ENV=demo                                   # demo enables scenario reset and demo identities
DATABASE_URL=postgresql://avnadmin:CHANGE_ME@your-project.aivencloud.com:12345/defaultdb   # SECRET
DATABASE_SSL_MODE=verify-full                  # verify-full (required for Aiven) | disable (loopback DB only)
DATABASE_CA_CERT=./secrets/aiven-ca.pem       # local path; compose mounts it and overrides this to /run/certs/aiven-ca.pem
SESSION_SIGNING_KEY=                           # SECRET, >= 32 chars: python -c "import secrets;print(secrets.token_urlsafe(48))"
SDK_TOKEN_SECRET=                              # SECRET, >= 32 chars: derives per-customer SDK tokens (scripts/sdk_token.py)
R2M_INTERNAL_API_URL=http://127.0.0.1:8000     # private FastAPI listener used by the SDK and Next server rendering
R2M_GRANT_SIGNING_KEY=                         # optional; leave empty so each grant is signed with the agent's own SDK token

# --- Optional: Keewano (advisory analytics) ----------------------------------
KEEWANO_ENABLED=false
KEEWANO_API_KEY=                               # SECRET, ingestion only
KEEWANO_PAT=                                   # SECRET, MCP personal access token only
KEEWANO_INGEST_URL=https://api.keewano.com/event/ingress/v1/json/in
KEEWANO_REGISTER_URL=https://api.keewano.com/event/ingress/v1/json/custom
KEEWANO_MCP_URL=https://api.keewano.com/mcp

# --- Frontend (non-secret only) ----------------------------------------------
NEXT_PUBLIC_APP_LABEL="R2M prototype (demo)"
